// ═══════════════════════════════════════════════════════════════
// SHALIACH AI — Prisma Schema
// FixHubTech Outreach & Sales Intelligence
// ═══════════════════════════════════════════════════════════════
// 18 Models · PostgreSQL · Designed for millions of leads
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (Single-user V1) ──────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("users")
}

// ─── Sender Profile ─────────────────────────────────────────

model SenderProfile {
  id             String   @id @default(uuid())
  name           String
  fromName       String   @map("from_name")
  fromEmail      String   @map("from_email")
  replyToEmail   String   @map("reply_to_email")
  companyName    String   @map("company_name")
  companyWebsite String   @map("company_website")
  postalAddress  String   @map("postal_address") @default("")
  signature      String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@map("sender_profiles")
}

// ─── Lead List ───────────────────────────────────────────────

model LeadList {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leads      Lead[]
  importJobs ImportJob[]

  @@map("lead_lists")
}

// ─── Lead ────────────────────────────────────────────────────

model Lead {
  id              String   @id @default(uuid())
  businessName    String?  @map("business_name")
  email           String
  normalizedEmail String   @map("normalized_email")
  firstName       String?  @map("first_name")
  website         String?
  category        String?
  city            String?
  state           String?
  country         String?
  notes           String?
  source          String?

  validationStatus String  @default("UNKNOWN") @map("validation_status")
  crmStatus        String  @default("IMPORTED") @map("crm_status")

  leadListId  String?  @map("lead_list_id")
  importJobId String?  @map("import_job_id")

  lastContactedAt DateTime? @map("last_contacted_at")
  lastReplyAt     DateTime? @map("last_reply_at")

  expectedRevenue  Decimal @default(0) @map("expected_revenue") @db.Decimal(12, 2)
  confirmedRevenue Decimal @default(0) @map("confirmed_revenue") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leadList           LeadList?           @relation(fields: [leadListId], references: [id], onDelete: SetNull)
  importJob          ImportJob?          @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  campaignRecipients CampaignRecipient[]
  emailMessages      EmailMessage[]
  conversations      Conversation[]
  inboundMessages    InboundMessage[]
  revenueEntries     RevenueEntry[]

  @@unique([normalizedEmail])
  @@index([validationStatus])
  @@index([crmStatus])
  @@index([category])
  @@index([country])
  @@index([state])
  @@index([city])
  @@index([leadListId])
  @@index([importJobId])
  @@index([createdAt])
  @@index([lastContactedAt])
  @@map("leads")
}

// ─── Import Job ──────────────────────────────────────────────

model ImportJob {
  id               String   @id @default(uuid())
  fileName         String   @map("file_name")
  originalFileName String   @map("original_file_name")
  fileSize         Int      @map("file_size")
  r2Key            String   @map("r2_key")
  status           String   @default("PENDING")

  columnMapping Json? @map("column_mapping")

  totalRows      Int @default(0) @map("total_rows")
  processedRows  Int @default(0) @map("processed_rows")
  successCount   Int @default(0) @map("success_count")
  duplicateCount Int @default(0) @map("duplicate_count")
  invalidCount   Int @default(0) @map("invalid_count")
  riskyCount     Int @default(0) @map("risky_count")
  suppressedCount Int @default(0) @map("suppressed_count")
  failureCount   Int @default(0) @map("failure_count")

  errors Json @default("[]")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  leadListId String? @map("lead_list_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leadList   LeadList?   @relation(fields: [leadListId], references: [id], onDelete: SetNull)
  leads      Lead[]
  importRows ImportRow[]

  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

// ─── Import Row (for tracking individual row results) ────────

model ImportRow {
  id          String  @id @default(uuid())
  importJobId String  @map("import_job_id")
  rowNumber   Int     @map("row_number")
  rawData     Json    @map("raw_data")
  status      String  // VALID, INVALID, DUPLICATE, SUPPRESSED, RISKY
  errorMessage String? @map("error_message")
  leadId      String? @map("lead_id")

  createdAt DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@index([status])
  @@map("import_rows")
}

// ─── Campaign ────────────────────────────────────────────────

model Campaign {
  id          String  @id @default(uuid())
  name        String
  description String?
  status      String  @default("DRAFT")

  mode String @default("AI") // MANUAL or AI

  senderProfileId String @map("sender_profile_id")

  subjectTemplate String? @map("subject_template")
  bodyTemplate    String? @map("body_template")
  aiPromptNotes   String? @map("ai_prompt_notes")

  dailySendLimit     Int    @default(200) @map("daily_send_limit")
  sendingWindowStart String? @map("sending_window_start")
  sendingWindowEnd   String? @map("sending_window_end")
  sendingTimezone    String @default("America/New_York") @map("sending_timezone")
  scheduledStartDate DateTime? @map("scheduled_start_date")

  enableFollowUp    Boolean @default(false) @map("enable_follow_up")
  followUpDelayDays Int     @default(3)     @map("follow_up_delay_days")

  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  deliveredCount  Int @default(0) @map("delivered_count")
  repliedCount    Int @default(0) @map("replied_count")
  bouncedCount    Int @default(0) @map("bounced_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  senderProfile      SenderProfile       @relation(fields: [senderProfileId], references: [id])
  campaignRecipients CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

// ─── Campaign Recipient ──────────────────────────────────────

model CampaignRecipient {
  id         String @id @default(uuid())
  campaignId String @map("campaign_id")
  leadId     String @map("lead_id")
  status     String @default("PENDING")

  emailMessageId    String? @map("email_message_id")
  followUpMessageId String? @map("follow_up_message_id")
  aiGenerationId    String? @map("ai_generation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead           @relation(fields: [leadId], references: [id])
  emailMessage  EmailMessage?  @relation("PrimaryEmail", fields: [emailMessageId], references: [id])
  followUpMessage EmailMessage? @relation("FollowUpEmail", fields: [followUpMessageId], references: [id])
  aiGeneration  AiGeneration?  @relation(fields: [aiGenerationId], references: [id])

  @@unique([campaignId, leadId])
  @@index([status])
  @@index([campaignId])
  @@index([leadId])
  @@map("campaign_recipients")
}

// ─── AI Generation ───────────────────────────────────────────

model AiGeneration {
  id                   String  @id @default(uuid())
  model                String
  promptTokens         Int     @default(0) @map("prompt_tokens")
  completionTokens     Int     @default(0) @map("completion_tokens")
  totalTokens          Int     @default(0) @map("total_tokens")
  durationMs           Int     @default(0) @map("duration_ms")
  success              Boolean @default(false)
  failureReason        String? @map("failure_reason")
  retryCount           Int     @default(0) @map("retry_count")
  result               Json?

  createdAt DateTime @default(now()) @map("created_at")

  campaignRecipients CampaignRecipient[]

  @@index([success])
  @@index([createdAt])
  @@map("ai_generations")
}

// ─── Email Message ───────────────────────────────────────────

model EmailMessage {
  id     String @id @default(uuid())
  leadId String @map("lead_id")

  fromEmail    String @map("from_email")
  fromName     String @map("from_name")
  replyToEmail String @map("reply_to_email")
  toEmail      String @map("to_email")

  subject  String
  textBody String @map("text_body")
  htmlBody String @map("html_body")

  status     String  @default("DRAFT")
  isFollowUp Boolean @default(false) @map("is_follow_up")

  providerMessageId String? @unique @map("provider_message_id")
  idempotencyKey    String  @unique @map("idempotency_key")

  sentAt       DateTime? @map("sent_at")
  deliveredAt  DateTime? @map("delivered_at")
  bouncedAt    DateTime? @map("bounced_at")
  complainedAt DateTime? @map("complained_at")
  failedAt     DateTime? @map("failed_at")
  failureReason String?  @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead                    Lead                @relation(fields: [leadId], references: [id])
  primaryRecipients       CampaignRecipient[] @relation("PrimaryEmail")
  followUpRecipients      CampaignRecipient[] @relation("FollowUpEmail")
  emailEvents             EmailEvent[]

  @@index([status])
  @@index([leadId])
  @@index([toEmail])
  @@index([createdAt])
  @@map("email_messages")
}

// ─── Email Event ─────────────────────────────────────────────

model EmailEvent {
  id              String   @id @default(uuid())
  emailMessageId  String   @map("email_message_id")
  providerEventId String   @unique @map("provider_event_id")
  eventType       String   @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@index([eventType])
  @@map("email_events")
}

// ─── Conversation ────────────────────────────────────────────

model Conversation {
  id            String   @id @default(uuid())
  leadId        String   @map("lead_id")
  subject       String
  lastMessageAt DateTime @map("last_message_at")
  messageCount  Int      @default(0) @map("message_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lead            Lead              @relation(fields: [leadId], references: [id])
  inboundMessages InboundMessage[]

  @@index([leadId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// ─── Inbound Message ─────────────────────────────────────────

model InboundMessage {
  id             String  @id @default(uuid())
  conversationId String  @map("conversation_id")
  leadId         String  @map("lead_id")

  fromEmail String  @map("from_email")
  fromName  String? @map("from_name")
  toEmail   String  @map("to_email")
  subject   String
  textBody  String? @map("text_body")
  htmlBody  String? @map("html_body")

  classification          String? @map("classification")
  classificationConfidence Float?  @map("classification_confidence")

  aiDraftReply         String?  @map("ai_draft_reply")
  aiDraftReplyApproved Boolean  @default(false) @map("ai_draft_reply_approved")

  receivedAt DateTime @map("received_at")
  createdAt  DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id])

  @@index([conversationId])
  @@index([leadId])
  @@index([classification])
  @@index([receivedAt])
  @@map("inbound_messages")
}

// ─── Suppression List ────────────────────────────────────────

model SuppressionEntry {
  id              String   @id @default(uuid())
  normalizedEmail String   @unique @map("normalized_email")
  reason          String
  source          String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([normalizedEmail])
  @@map("suppression_entries")
}

// ─── Webhook Event (raw storage) ─────────────────────────────

model WebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @map("provider_event_id")
  provider        String    @default("resend")
  eventType       String    @map("event_type")
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at")
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([processed])
  @@index([eventType])
  @@index([createdAt])
  @@map("webhook_events")
}

// ─── Audit Log ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Revenue Entry ───────────────────────────────────────────

model RevenueEntry {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String
  type        String   // EXPECTED, CONFIRMED, ADJUSTMENT
  recordedAt  DateTime @map("recorded_at")
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@index([type])
  @@index([recordedAt])
  @@map("revenue_entries")
}

// ─── Setting ─────────────────────────────────────────────────

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
