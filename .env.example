NODE_ENV=production
PORT=3001
APP_URL=https://shaliach.yourdomain.com
API_URL=https://api.shaliach.yourdomain.com

# PostgreSQL
POSTGRES_USER=shaliach
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=shaliach_prod
DATABASE_URL=postgresql://shaliach:your_secure_password@postgres:5432/shaliach_prod?schema=public

# Redis
REDIS_PASSWORD=your_secure_password
REDIS_URL=redis://:your_secure_password@redis:6379/0

# Security Secrets
SESSION_SECRET=your_32_character_session_secret_key_here
ENCRYPTION_KEY=your_32_character_encryption_key_here
CSRF_SECRET=your_16_char_csrf_secret

# Groq AI (Free tier at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=1000
GROQ_TEMPERATURE=0.4

# Resend Email (Free tier: 3,000 emails/mo at resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Your Name <outreach@yourdomain.com>"
RESEND_REPLY_TO="outreach@yourdomain.com"

# Telegram Bot (Free via @BotFather & @userinfobot)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
